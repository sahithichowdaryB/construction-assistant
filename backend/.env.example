# SiteMate backend configuration. Copy to backend/.env (Git-ignored) and fill in. Never commit real values.
# Order of provisioning: alembic upgrade head -> provision_reader.py -> provision_agent.py -> provision_ops.py -> seeds.

# --- Database logins (Supabase session pooler) ---------------------------------------------------------------------
# Admin login: migrations and seeds.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ADMIN_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Read-only API login (sitemate_reader, provision_reader.py).
DATABASE_URL=postgresql+psycopg://sitemate_reader.PROJECT_REF:READER_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Optional least-privilege login for document, draft and performance writes; MIGRATION_DATABASE_URL is used when unset.
WRITER_DATABASE_URL=
# Capture pipeline login (sitemate_agent, provision_agent.py). Capture returns 503 without it.
AGENT_DATABASE_URL=postgresql+psycopg://sitemate_agent.PROJECT_REF:AGENT_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Manager actions and the worker (sitemate_ops, provision_ops.py). When unset they use the writer login and log a
# warning: fine on a laptop, provision the role before sharing a deployment.
OPS_DATABASE_URL=postgresql+psycopg://sitemate_ops.PROJECT_REF:OPS_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Static bearer tokens for scripts and the demo proxy (random, at least 32 characters each).
RIVERSIDE_DEMO_TOKEN=generate-a-random-string-of-at-least-32-characters
TST_DEMO_TOKEN=

# --- Claude (Anthropic API) ----------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Documents, correspondence, performance P1/P2/P4, plan summaries and the daily report drafter.
DOCS_LLM_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max (search reranking always runs at low)
DOCS_LLM_EFFORT=medium
# Incident root cause, action planner and performance P3 (ai-agent/app/llm.py). Only "claude" is supported.
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=
# Capture pipeline; falls back to CLAUDE_MODEL / CLAUDE_EFFORT, then LLM_MODEL / LLM_EFFORT.
CAPTURE_LLM_MODEL=
CAPTURE_LLM_EFFORT=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
# Ask SiteMate (chat); falls back to DOCS_LLM_MODEL.
ASK_LLM_MODEL=
ASK_LLM_EFFORT=medium

# --- Speech-to-text (Whisper) --------------------------------------------------------------------------------------
# Either an OpenAI key, or WHISPER_BASE_URL for an OpenAI-compatible server such as backend/whisper-server
# (http://127.0.0.1:8001). Without either, voice notes ask the speaker to type the note instead.
OPENAI_API_KEY=
WHISPER_BASE_URL=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=en
# Largest accepted recording (bytes, default 25 MB).
AGENT_MAX_AUDIO_BYTES=26214400

# --- Storage -------------------------------------------------------------------------------------------------------
# Private upload storage (default: backend/storage, Git-ignored).
SITEMATE_STORAGE=
AGENT_IMAGE_DIR=storage/images
# Reference plan PDFs (default ../mock_data) and the project they belong to.
PLAN_FILES_DIR=
PLAN_FILES_PROJECT=RIV

# --- Sign-in -------------------------------------------------------------------------------------------------------
# Base URL of the web app, used in password reset links.
APP_URL=http://localhost:3000
# No mail service is configured: reset links are written to the API log. true also shows the link on
# the "Forgot password" page. Development only: anyone who knows an email could then reset it.
AUTH_DEV_RESET_LINKS=false

# --- Capture and worker options (all optional) ---------------------------------------------------------------------
AGENT_MAX_IMAGES=5
AGENT_MAX_QUESTION_ROUNDS=2
AGENT_REASONING_DELAY_SECONDS=60
AGENT_ESCALATE_AFTER_HOURS=24
AGENT_AUTO_RESOLVE_HOURS=12
# A job left 'running' longer than this (a stopped worker) is queued again.
AGENT_STUCK_JOB_SECONDS=600
