MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ADMIN_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://sitemate_reader.PROJECT_REF:READER_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Optional least-privilege login for ingestion writes; MIGRATION_DATABASE_URL is used when unset.
WRITER_DATABASE_URL=
RIVERSIDE_DEMO_TOKEN=generate-a-random-string-of-at-least-32-characters

# Claude API key, shared by the documents module and the Node.js capture agent.
ANTHROPIC_API_KEY=

# --- Documents module (backend/documents): summaries, scanned-page OCR, photo captions, search reranking ---
DOCS_LLM_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max (reranking always runs at low)
DOCS_LLM_EFFORT=medium
# Private upload storage (default: backend/storage, Git-ignored)
SITEMATE_STORAGE=

# --- Sign-in ---
# Base URL of the web app, used in password reset links.
APP_URL=http://localhost:3000
# No mail service is configured: reset links are written to the API log. true also shows the link on
# the "Forgot password" page. Development only: anyone who knows an email could then reset it.
AUTH_DEV_RESET_LINKS=false

# --- Node.js capture agent (src/app.js) ---
# Role created by provision_agent.py (SELECT + INSERT on capture tables).
AGENT_DATABASE_URL=postgresql+psycopg://sitemate_agent.PROJECT_REF:AGENT_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Optional: path to the Supabase CA certificate to verify TLS.
AGENT_DATABASE_CA_CERT=
AGENT_PORT=4000
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
CLAUDE_FALLBACKS=default
# Whisper: OpenAI API key, or WHISPER_BASE_URL for a self-hosted OpenAI-compatible Whisper server.
OPENAI_API_KEY=
WHISPER_BASE_URL=
WHISPER_MODEL=whisper-1
AGENT_MAX_QUESTION_ROUNDS=2
