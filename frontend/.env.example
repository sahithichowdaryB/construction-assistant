# Server-side only. Never prefix these with NEXT_PUBLIC_.
SITEMATE_API_URL=http://127.0.0.1:8000
SITEMATE_API_TOKEN=

# true  = every endpoint is served from fixtures/ (no backend needed)
# false = endpoints the backend already implements go through /api/sm/* to SITEMATE_API_URL;
#         endpoints listed as planned in lib/endpoints.ts keep using fixtures.
#         Sign-in is required in this mode: each request carries the signed-in user's session
#         (httpOnly cookie) instead of SITEMATE_API_TOKEN. Accounts: backend/seed_demo_users.py
NEXT_PUBLIC_USE_FIXTURES=true

# Development only: demo logins listed on the sign-in page with a "Use" button. Ignored in production
# builds. Format: Label|email|password;Label|email|password  (passwords from backend/seed_demo_users.py)
SITEMATE_DEV_ACCOUNTS=

# Optional: browse the dummy agent project instead of Riverside (use the TST token in SITEMATE_API_TOKEN)
# NEXT_PUBLIC_PROJECT_ID=TST

# Capture agent (backend/, Node + Claude). Server-side only, used by /api/agent/*.
# AGENT_API_TOKEN is the bearer token of a contributor/manager/approver member (e.g. RIVERSIDE_DEMO_TOKEN).
AGENT_API_URL=http://127.0.0.1:4000
AGENT_API_TOKEN=
